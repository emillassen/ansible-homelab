nextcloud.indud.io {
	import cloudflare_mtls
	reverse_proxy 192.168.1.121:11000 {
		transport http {
			read_timeout 86400s
		}
		# Cloudflare's real client IP (CF-Connecting-IP) as X-Forwarded-For.
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
	# Unlimited upload size
	request_body {
		max_size 0
	}
}

