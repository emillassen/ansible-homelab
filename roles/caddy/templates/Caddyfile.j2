# Managed by Ansible (roles/caddy/templates/Caddyfile.j2).
{
	admin off
	email admin@hjem.sh
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	servers {
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
		trusted_proxies_strict
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 2160h
		}
	}
}

(cloudflare_mtls) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/cloudflare-origin-pull-ca.pem
			}
		}
	}
}

