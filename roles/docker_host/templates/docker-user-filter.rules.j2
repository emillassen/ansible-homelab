# Managed by Ansible (roles/docker_host). Loaded with iptables-restore --noflush:
# declaring the chain replaces its rules in one commit, the rest of the table stays.
*filter
:DOCKER-USER - [0:0]
-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
{% for rule in docker_user_filter %}
{% for src in ([rule.allow] if rule.allow is string else rule.allow) %}
-A DOCKER-USER -s {{ src }}/32 -p tcp -m conntrack --ctorigdst {{ ansible_facts.default_ipv4.address }} --ctorigdstport {{ rule.port }} -j RETURN
{% endfor %}
-A DOCKER-USER -p tcp -m conntrack --ctorigdst {{ ansible_facts.default_ipv4.address }} --ctorigdstport {{ rule.port }} -j DROP
{% endfor %}
-A DOCKER-USER -j RETURN
COMMIT
