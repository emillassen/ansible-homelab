#!/usr/bin/env bash
# run check|apply|verify [--limit PATTERN]
# run provision|migrate [--check] --limit PATTERN
# run nightly [--dry-run|--now] | hold GUEST REASON... | release GUEST | held
set -Eeuo pipefail

if [ "$(id -u)" -eq 0 ]; then
  exec runuser -u ansible -- "$0" "$@"
fi

usage() {
  echo "usage: run check|apply|verify [--limit PATTERN]" >&2
  echo "       run provision|migrate [--check] --limit PATTERN" >&2
  echo "       run nightly [--dry-run|--now] | hold GUEST REASON... | release GUEST | held" >&2
  exit 64
}

home=/home/ansible
# Ansible needs a locale that exists; C.UTF-8 always does, even before base generates the rest.
export LANG=C.UTF-8 LC_ALL=C.UTF-8
pattern='^[A-Za-z0-9_.,:&!-]+$'

verb="${1:-}"
[ -n "$verb" ] || usage
shift

# The nightly deploy takes run.lock itself.
case "$verb" in
  nightly)
    case "${1:-}" in
      "") exec /usr/local/sbin/ansible-nightly run ;;
      --now) [ $# -eq 1 ] || usage; exec /usr/local/sbin/ansible-nightly run --now ;;
      --dry-run) [ $# -eq 1 ] || usage; exec /usr/local/sbin/ansible-nightly dry-run ;;
      *) usage ;;
    esac
    ;;
  hold | release | held) exec /usr/local/sbin/ansible-nightly "$verb" "$@" ;;
esac

limit=""
check=""
while [ $# -gt 0 ]; do
  case "$1" in
    --limit)
      [ $# -ge 2 ] || usage
      [[ "$2" =~ $pattern ]] || usage
      limit="$2"
      shift 2
      ;;
    --check)
      [ "$verb" = provision ] || [ "$verb" = migrate ] || usage
      check="--check"
      shift
      ;;
    *) usage ;;
  esac
done

args=()
case "$verb" in
  check) args=(playbooks/site.yml --check --diff) ;;
  apply) args=(playbooks/site.yml) ;;
  verify) args=(playbooks/verify.yml) ;;
  provision)
    [ -n "$limit" ] || { echo "provision needs --limit" >&2; exit 64; }
    args=(playbooks/provision.yml)
    [ -z "$check" ] || args+=(--check)
    ;;
  migrate)
    [ -n "$limit" ] || { echo "migrate needs --limit <host>,<host>-old" >&2; exit 64; }
    args=(playbooks/migrate.yml)
    [ -z "$check" ] || args+=(--check)
    ;;
  *) usage ;;
esac
[ -z "$limit" ] || args+=(--limit "$limit")

exec 9>/home/ansible/run.lock
flock -n 9 || { echo "busy: another sync or run holds the lock" >&2; exit 75; }

# sync writes the hash after the tooling installs all succeed.
want=$(cd /opt/ansible && sha256sum requirements-uv.txt requirements.txt requirements.yml | sha256sum | cut -d' ' -f1)
if [ "$(cat "$home/.tooling-installed" 2>/dev/null)" != "$want" ]; then
  echo "refusing: the installed tooling doesn't match /opt/ansible; run sync" >&2
  exit 1
fi

export ANSIBLE_CONFIG=/opt/ansible/ansible.cfg
export ANSIBLE_VAULT_PASSWORD_FILE="$home/.vault-pass"
export ANSIBLE_COLLECTIONS_PATH="$home/collections"
export ANSIBLE_LOG_PATH="$home/log/ansible.log"

cd /opt/ansible
echo "commit: $(git -C "$home/src" log -1 --oneline)"

# Stop the play if whoever started it goes away (Ctrl-C on an SSH session leaves
# no terminal to send a hangup, so the play would run on holding the lock).
parent=$PPID
"$home/venv/bin/ansible-playbook" "${args[@]}" &
play=$!
while kill -0 "$play" 2>/dev/null; do
  # /proc, not kill -0: the caller is often sshd, which runs as root.
  if [ ! -d "/proc/$parent" ]; then
    echo "caller gone, stopping the play" >&2
    kill -TERM "$play"
  fi
  sleep 2
done
wait "$play"
