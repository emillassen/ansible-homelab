#!/usr/bin/env bash
# sync [SHA]: pull the repo (or fast-forward to exactly SHA, for the nightly deploy) and
# copy it to /opt/ansible. Runs as the ansible user on the controller. The Python and
# collection installs run only when the requirement files changed; their hash goes to
# .tooling-installed after all three succeed, and run refuses without a matching one.
set -Eeuo pipefail

if [ "$(id -u)" -eq 0 ]; then
  exec runuser -u ansible -- "$0" "$@"
fi

target="${1:-}"
if [ -n "$target" ] && ! [[ "$target" =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: sync [full commit SHA]" >&2
  exit 64
fi

home=/home/ansible
# Ansible needs a locale that exists; C.UTF-8 always does, even before base generates the rest.
export LANG=C.UTF-8 LC_ALL=C.UTF-8
export UV_NO_CONFIG=1
export ANSIBLE_COLLECTIONS_PATH="$home/collections"
# bootstrap-controller.sh holds the lock itself and sets ANSIBLE_LOCK_HELD.
if [ -z "${ANSIBLE_LOCK_HELD:-}" ]; then
  exec 9>/home/ansible/run.lock
  flock -n 9 || { echo "busy: another sync or run holds the lock" >&2; exit 75; }
fi

cd "$home/src"
if [ "$(git rev-parse --abbrev-ref HEAD)" != main ]; then
  echo "refusing: $home/src is not on main" >&2
  exit 1
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "refusing: $home/src has local changes" >&2
  exit 1
fi

if [ -z "$target" ]; then
  git pull --ff-only
else
  git fetch --quiet origin main
  git merge-base --is-ancestor "$target" origin/main || { echo "refusing: $target is not on origin/main" >&2; exit 1; }
  git merge-base --is-ancestor HEAD "$target" || { echo "refusing: $home/src is ahead of or diverged from $target" >&2; exit 1; }
  git merge --quiet --ff-only "$target"
fi
rsync -a --delete --exclude .git "$home/src/" /opt/ansible/

marker="$home/.tooling-installed"
want=$(cd /opt/ansible && sha256sum requirements-uv.txt requirements.txt requirements.yml | sha256sum | cut -d' ' -f1)
if [ "$(cat "$marker" 2>/dev/null)" != "$want" ]; then
  rm -f "$marker"
  "$home/uv/bin/pip" install --quiet --disable-pip-version-check -r /opt/ansible/requirements-uv.txt
  "$home/uv/bin/uv" pip install --quiet --python "$home/venv" -r /opt/ansible/requirements.txt
  "$home/venv/bin/ansible-galaxy" collection install --upgrade -r /opt/ansible/requirements.yml -p "$home/collections"
  echo "$want" > "$marker"
fi

git log -1 --oneline
